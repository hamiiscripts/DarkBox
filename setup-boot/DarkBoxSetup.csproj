<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>DarkBoxSetup</RootNamespace>
    <AssemblyName>DarkBoxSetup</AssemblyName>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <LangVersion>7.3</LangVersion>
    <Version>4.2.0</Version>
    <FileVersion>4.2.0.0</FileVersion>
    <AssemblyVersion>4.2.0.0</AssemblyVersion>
    <!-- v4.1.0: same publisher identity as the app, so the SETUP exe
         itself stops looking anonymous to SmartScreen (see SIGNING.md —
         identity alone does not remove the warning; signing does). -->
    <Company>Hamii Scripts</Company>
    <Product>DarkBox by Hamii</Product>
    <Copyright>Copyright © 2026 Hamii Scripts</Copyright>
    <Description>DarkBox by Hamii Setup</Description>
    <AssemblyTitle>DarkBox Setup</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="payload.zip">
      <LogicalName>payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
